#include "FX_time.h"
#include <algorithm>
#include <array>
#include <cassert>
#include <cmath>
#include <cstdio>
#define M_PI 3.14159265358979323846
#define M_TWOPI (2 * M_PI)

static float sin_t(float x) { return std::sin(x); }
static float cos_t(float x) { return std::cos(x); }
static int16_t sin16_t(uint16_t x) { return int16_t(std::sin(x * M_TWOPI / 65536) * 32767); }
static int16_t cos16_t(uint16_t x) { return sin16_t(uint16_t(x + 16384)); }

struct MockSegment {
  EffectClocks effectClocks;
  uint8_t speed = 127, intensity = 112, custom1 = 0;
  bool check1 = true, check2 = false, check3 = true;
  int width = 64, height = 1;
  std::array<uint32_t, 4096> pixels = {};
  uint32_t color_wheel(uint8_t index) { return index; }
  void setPixelColor(int x, uint32_t color) { assert(x >= 0 && x < width); pixels[x] = color; }
  void setPixelColorXY(int x, int y, uint32_t color) {
    assert(x >= 0 && x < width && y >= 0 && y < height);
    pixels[y * width + x] = color;
  }
} segment;
struct MockStrip {
  uint32_t now = 1234567, timebase = 0;
  bool isMatrix = false;
  int getActiveSegmentsNum() { return 1; }
  int getCurrSegmentId() { return 0; }
} strip;
#define SEGMENT segment
#define SEGENV segment
#define SEG_W segment.width
#define SEG_H segment.height

// @ACTUAL_FUNCTIONS@
// @BASELINE@

int main() {
#ifdef HAS_BASELINE
  original_palette();
  const auto originalBefore = segment.pixels;
  segment.speed = 128;
  original_palette();
  assert(segment.pixels != originalBefore); // this harness detects the supplied release's bug
#endif
  for (bool matrix : {false, true}) {
    for (bool rotation : {false, true}) {
      segment = MockSegment{};
      strip = MockStrip{};
      strip.isMatrix = matrix;
      segment.width = matrix ? 16 : 64;
      segment.height = matrix ? 16 : 1;
      segment.check2 = rotation;
      strip.now = 0xE1234567; // long uptime, where absolute-time rate edits are most visible
      mode_palette();
      for (unsigned speed = 0; speed < 255; ++speed) {
        segment.speed = uint8_t(speed);
        if (rotation) segment.custom1 = uint8_t(speed);
        strip.now += 17;
        mode_palette();
        const auto before = segment.pixels;
        ++segment.speed;
        if (rotation) ++segment.custom1;
        mode_palette();
        assert(segment.pixels == before); // same timestamp: every pixel must stay put
      }
      // A network timebase correction must not be mistaken for elapsed uptime.
      const auto beforeSync = segment.pixels;
      strip.timebase += 123000;
      strip.now += 123000;
      mode_palette();
      assert(segment.pixels == beforeSync);
      // Motion continues, using the new rate. This also catches accidental freezing.
      strip.now += 137;
      mode_palette();
      assert(segment.pixels != beforeSync);
      // Static Shift still means an absolute offset (the original UI contract).
      segment.check1 = false;
      mode_palette();
      const auto beforeStaticShift = segment.pixels;
      --segment.speed;
      mode_palette();
      assert(segment.pixels != beforeStaticShift);
    }
  }
#ifdef ESP8266
  puts("Actual Palette rendering passed: integer branch, 1D/2D, all adjacent speed edits, rotation and sync");
